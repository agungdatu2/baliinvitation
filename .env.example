DATABASE_URL="postgresql://user:password@localhost:5432/baliinvitation"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Dipakai sekali oleh `npx prisma db seed` untuk membuat/reset akun admin
# pertama (lihat prisma/seed.ts) — boleh dihapus dari .env setelah admin
# dibuat, tidak dibaca di tempat lain.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
