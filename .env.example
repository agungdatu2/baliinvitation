DATABASE_URL="postgresql://user:password@localhost:5432/baliinvitation"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Dipakai sekali oleh `npx prisma db seed` untuk membuat/reset akun admin
# pertama (lihat prisma/seed.ts) — boleh dihapus dari .env setelah admin
# dibuat, tidak dibaca di tempat lain.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Section "Testimoni" di landing page (src/lib/services/google-reviews.ts) —
# kosongkan keduanya untuk sembunyikan section ini sepenuhnya (tidak fallback
# ke data palsu). GOOGLE_PLACES_API_KEY: buat di Google Cloud Console, aktifkan
# "Places API", batasi key-nya khusus API ini (server-side only, jangan dipakai
# di client). GOOGLE_PLACE_ID: cari lewat https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
